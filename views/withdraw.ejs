  width: 100%;
  max-width: 500px;
  background: #ffffff;
  padding: 35px;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
}

.card h2 {
  text-align: center;
  color: #2c3e50;
  margin-bottom: 25px;
  font-size: 2rem;
}

.error-message {
  background: #fdecea;
  color: #c0392b;
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-weight: 600;
}

.withdraw-info {
  background: #eef4ff;
  color: #2c3e50;
  padding: 15px;
  border-radius: 8px;
  margin-bottom: 20px;
}

.withdraw-info strong {
  color: #1a73e8;
}

.withdraw-info p {
  margin: 7px 0 0;
