

<header>
  <div class="logo-container">
    <img src="/images/background.jpg" alt="Logo">
    <h1>Stonebridge Capital</h1>
  </div>
  <nav>
    <!-- your nav links -->
  </nav>
</header>


<div class="dashboard-card">
  <h2>Dashboard</h2>

  <div class="dashboard-grid">

    <!-- User Info Sub-Card -->
    <div class="dashboard-subcard user-info">
      <h3>👤 Welcome, <%= user.username %></h3>
      <table class="dashboard-table">
        <tr>
          <th>Email</th>
          <td><%= user.email %></td>
        </tr>
        <tr>
          <th>Wallet</th>
          <td><%= user.wallet || "Not set" %></td>
        </tr>
        <tr>
          <th>Balance</th>
          <td>$<%= (typeof user.balance === 'number' ? user.balance : parseFloat(user.balance) || 0).toFixed(2) %></td>
        </tr>
      </table>

      <div class="actions">
        <a href="/deposit" class="btn deposit-btn">💰 Deposit</a>
        <a href="/withdraw" class="btn withdraw-btn">💸 Withdraw</a>
      </div>
    </div>

    <!-- Deposits & Plan Gains Sub-Card -->
    <div class="dashboard-subcard deposits">
      <h3>💹 Your Deposits & Plan Gains</h3>
      <% if (!deposits || deposits.length === 0) { %>
        <p>No deposits yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Plan</th>
                <th>Amount ($)</th>
                <th>Daily Gain ($)</th>
                <th>Weekly Gain ($)</th>
                <th>Monthly Gain ($)</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% deposits.forEach(dep => { %>
                <tr>
                  <td><%= dep.plan_name %></td>
                  <td>$<%= parseFloat(dep.amount).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.daily_gain).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.weekly_gain).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.monthly_gain).toFixed(2) %></td>
                  <td><%= dep.status %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Referrals Section A --><div class="dashboard-subcard">
  <h3>Your Referral Link</h3>
  <input type="text" readonly value="<%= user.referral_link %>" style="width: 100%; padding: 8px;" />
  <p>Share this link with friends to earn referral bonuses across 3 levels!</p>
</div>

    <div class="dashboard-subcard referrals section-a">
      <h3>🅰️ Referrals Section A</h3>
      <% if (!referralsA || referralsA.length === 0) { %>
        <p>No referrals in Section A yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Level</th>
                <th>Matching Bonus (%)</th>
                <th>Matched Amount ($)</th>
                <th>Bonus Earned ($)</th>
              </tr>
            </thead>
            <tbody>
              <% referralsA.forEach(ref => { %>
                <tr>
                  <td><%= ref.referred_name || 'N/A' %></td>
                  <td><%= ref.referred_email || 'N/A' %></td>
                  <td><%= ref.level || 0 %></td>
                  <td><%= ref.bonus_percent || 0 %></td>
                  <td>$<%= parseFloat(ref.matched_amount || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(ref.bonus_earned || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Referrals Section B -->
    <div class="dashboard-subcard referrals section-b">
      <h3>🅱️ Referrals Section B</h3>
      <% if (!referralsB || referralsB.length === 0) { %>
        <p>No referrals in Section B yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Level</th>
                <th>Matching Bonus (%)</th>
                <th>Matched Amount ($)</th>
                <th>Bonus Earned ($)</th>
              </tr>
            </thead>
            <tbody>
              <% referralsB.forEach(ref => { %>
                <tr>
                  <td><%= ref.referred_name || 'N/A' %></td>
                  <td><%= ref.referred_email || 'N/A' %></td>
                  <td><%= ref.level || 0 %></td>
                  <td><%= ref.bonus_percent || 0 %></td>
                  <td>$<%= parseFloat(ref.matched_amount || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(ref.bonus_earned || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</div>

<style>
/* Main Card */
.dashboard-card {
  width: 95%;
  max-width: 1500px;
  margin: 30px auto;
  padding: 30px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  font-family: 'Arial', sans-serif;
}

/* Main Title */
.dashboard-card h2 {
  color: #2c3e50;
  font-size: 2.8rem;
  text-align: center;
  margin-bottom: 40px;
  font-weight: 700;
  letter-spacing: 1px;
  position: relative;
}

.dashboard-card h2::after {
  content: "";
  display: block;
  width: 100px;
  height: 5px;
  background: linear-gradient(90deg, #1a73e8, #4facfe);
  margin: 12px auto 0;
  border-radius: 3px;
}

/* Grid Layout */
.dashboard-grid {
  display: grid;
  gap: 25px;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
}

/* Sub-Cards */
.dashboard-subcard {
  background: #f9f9f9;
  border-radius: 16px;
  padding: 25px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  transition: transform 0.25s, box-shadow 0.25s;
}

.dashboard-subcard:hover {
  transform: translateY(-6px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

/* Sub-Card Headings */
.dashboard-subcard h3 {
  font-size: 1.5rem;
  font-weight: 600;
  margin-bottom: 20px;
  padding: 12px 18px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  color: #fff;
  box-shadow: 0 3px 10px rgba(0,0,0,0.2);
}

/* Colors by Section */
.dashboard-subcard.section-a h3 {
  background: linear-gradient(120deg, #1a73e8, #4facfe);
}

.dashboard-subcard.section-b h3 {
  background: linear-gradient(120deg, #8e44ad, #9b59b6);
}

.dashboard-subcard.user-info h3 {
  background: linear-gradient(120deg, #2ecc71, #27ae60);
}

.dashboard-subcard.deposits h3 {
  background: linear-gradient(120deg, #f39c12, #f1c40f);
}

/* Tables */
.table-wrapper {
  overflow-x: auto;
}

.dashboard-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
}

.dashboard-table th,
.dashboard-table td {
  padding: 14px 16px;
  text-align: center;
  border: 1px solid #ddd;
  transition: background 0.25s;
}

.dashboard-table th {
  background-color: #1a73e8;
  color: #fff;
  text-transform: uppercase;
  position: sticky;
  top: 0;
  z-index: 1;
}

.dashboard-table tr:nth-child(even) {
  background-color: #f7f8fa;
}

.dashboard-table tr:hover {
  background-color: #eef4ff;
}

/* Buttons */
button,
.btn {
  background: #2ecc71;
  color: #fff;
  border: none;
  padding: 10px 22px;
  cursor: pointer;
  border-radius: 10px;
  font-weight: 700;
  text-decoration: none;
  margin-right: 10px;
  transition: all 0.25s;
}

button:hover,
.btn:hover {
  transform: translateY(-2px);
  background: #27ae60;
}

.deposit-btn {
  background: linear-gradient(to right, #1a73e8, #4facfe);
}

.withdraw-btn {
  background: linear-gradient(to right, #f44336, #ff7961);
}
</style>
