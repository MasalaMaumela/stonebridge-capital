<header>
  <div class="logo-container">
    <img src="/images/background.jpg" alt="Logo" style="height:50px; border-radius:8px;">
    <h1>Stonebridge Capital</h1>
  </div>
</header>

<div class="dashboard-card">
  <h2>Dashboard</h2>

  <div class="dashboard-grid">
    <!-- User Info -->
    <div class="dashboard-subcard user-info">
      <h3>👤 Welcome, <%= user.username %></h3>
      <table class="dashboard-table">
        <tr><th>Email</th><td><%= user.email %></td></tr>
        <tr><th>Wallet</th><td><%= user.wallet || "Not set" %></td></tr>
        <tr><th>Balance</th><td>$<%= parseFloat(user.balance || 0).toFixed(2) %></td></tr>
      </table>
      <div class="actions">
        <a href="/deposit" class="btn deposit-btn">💰 Deposit</a>
        <a href="/withdraw" class="btn withdraw-btn">💸 Withdraw</a>
      </div>
    </div>

    <!-- Deposits -->
    <div class="dashboard-subcard deposits">
      <h3>💹 Your Deposits & Gains</h3>
      <% if (!deposits || deposits.length === 0) { %>
        <p>No deposits yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Plan</th><th>Amount ($)</th><th>Daily Gain ($)</th>
                <th>Weekly Gain ($)</th><th>Monthly Gain ($)</th><th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% deposits.forEach(dep => { %>
                <tr>
                  <td><%= dep.plan_name %></td>
                  <td>$<%= parseFloat(dep.amount).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.daily_gain || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.weekly_gain || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(dep.monthly_gain || 0).toFixed(2) %></td>
                  <td>
                    <% if(dep.status === "Active") { %>
                      <span class="status approved">✅ Active</span>
                    <% } else if(dep.status === "Pending") { %>
                      <span class="status pending">⏳ Pending</span>
                    <% } else { %>
                      <span class="status rejected">❌ Rejected</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Referral Link -->
    <div class="dashboard-subcard referrals">
      <h3>Your Referral Link</h3>
      <input type="text" readonly value="<%= user.referral_link %>" style="width:100%;padding:8px;border-radius:6px;" />
      <p>Share to earn referral bonuses across 3 levels!</p>
    </div>

    <!-- Section A Referrals -->
    <div class="dashboard-subcard referrals section-a">
      <h3>🅰️ Section A Referrals</h3>
      <% if (!referralsA || referralsA.length === 0) { %>
        <p>No referrals yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Name</th><th>Email</th><th>Level</th>
                <th>Bonus (%)</th><th>Matched ($)</th><th>Bonus Earned ($)</th>
              </tr>
            </thead>
            <tbody>
              <% referralsA.forEach(ref => { %>
                <tr>
                  <td><%= ref.referred_name || 'N/A' %></td>
                  <td><%= ref.referred_email || 'N/A' %></td>
                  <td><%= ref.level || 0 %></td>
                  <td><%= ref.bonus_percent || 0 %></td>
                  <td>$<%= parseFloat(ref.matched_amount || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(ref.bonus_earned || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Section B Referrals -->
    <div class="dashboard-subcard referrals section-b">
      <h3>🅱️ Section B Referrals</h3>
      <% if (!referralsB || referralsB.length === 0) { %>
        <p>No referrals yet.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="dashboard-table">
            <thead>
              <tr>
                <th>Name</th><th>Email</th><th>Level</th>
                <th>Bonus (%)</th><th>Matched ($)</th><th>Bonus Earned ($)</th>
              </tr>
            </thead>
            <tbody>
              <% referralsB.forEach(ref => { %>
                <tr>
                  <td><%= ref.referred_name || 'N/A' %></td>
                  <td><%= ref.referred_email || 'N/A' %></td>
                  <td><%= ref.level || 0 %></td>
                  <td><%= ref.bonus_percent || 0 %></td>
                  <td>$<%= parseFloat(ref.matched_amount || 0).toFixed(2) %></td>
                  <td>$<%= parseFloat(ref.bonus_earned || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<style>
/* same CSS as before, no changes needed */
</style>
