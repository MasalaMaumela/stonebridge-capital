<header>
  <div class="logo-container">
    <h1>Stonebridge Capital</h1>
  </div>

  <nav>
    <a href="/admin">Admin Dashboard</a>
    <a href="/logout">Logout</a>
  </nav>
</header>

<div class="dashboard-card">

  <h2>Admin Dashboard</h2>

  <!-- SUCCESS / ERROR ALERTS -->

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert success">
      <%= success %>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error">
      <%= error %>
    </div>
  <% } %>


  <!-- KPI CARDS -->

  <div class="kpi-cards">

    <div class="kpi-card users-card">
      <h4>Total Users</h4>
      <p>
        <%= (users || []).length %>
      </p>
    </div>


    <div class="kpi-card deposits-card">
      <h4>Total Deposits (ZAR)</h4>
      <p>
        R<%= (deposits || [])
          .reduce((sum, d) => sum + parseFloat(d.amount || 0), 0)
          .toFixed(2) %>
      </p>
    </div>


    <div class="kpi-card withdrawals-card">
      <h4>Total Withdrawals (ZAR)</h4>
      <p>
        R<%= (withdrawals || [])
          .reduce((sum, w) => sum + parseFloat(w.amount || 0), 0)
          .toFixed(2) %>
      </p>
    </div>


    <div class="kpi-card referrals-card">
      <h4>Total Referral Bonus (ZAR)</h4>
      <p>
        R<%= (referrals || [])
          .reduce((sum, r) => sum + parseFloat(r.bonus_earned || 0), 0)
          .toFixed(2) %>
      </p>
    </div>

  </div>


  <!-- USERS -->

  <div class="dashboard-subcard users">

    <h3>👥 All Users</h3>

    <% const safeUsers = users || []; %>

    <% if (safeUsers.length === 0) { %>

      <p>No users found.</p>

    <% } else { %>

      <div class="table-wrapper">

        <table class="dashboard-table">

          <thead>
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Wallet</th>
              <th>Balance (ZAR)</th>
            </tr>
          </thead>

          <tbody>

            <% safeUsers.forEach(u => { %>

              <tr>

                <td>
                  <%= u.id %>
                </td>

                <td>
                  <%= u.name || "N/A" %>
                </td>

                <td>
                  <%= u.email %>
                </td>

                <td>
                  <%= u.wallet_address || "Not set" %>
                </td>

                <td>
                  R<%= parseFloat(u.balance || 0).toFixed(2) %>
                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>


  <!-- DEPOSITS -->

  <div class="dashboard-subcard deposits">

    <h3>💰 All Deposits & Gains</h3>

    <% const safeDeposits = deposits || []; %>

    <% if (safeDeposits.length === 0) { %>

      <p>No deposits found.</p>

    <% } else { %>

      <div class="table-wrapper">

        <table class="dashboard-table">

          <thead>

            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Email</th>
              <th>Plan</th>
              <th>Amount (ZAR)</th>
              <th>Daily Gain (ZAR)</th>
              <th>Total Earned (ZAR)</th>
              <th>TXID</th>
              <th>Status</th>
              <th>Action</th>
            </tr>

          </thead>

          <tbody>

            <% safeDeposits.forEach(d => { %>

              <tr>

                <td>
                  <%= d.id %>
                </td>

                <td>
                  <%= d.user_name || "N/A" %>
                </td>

                <td>
                  <%= d.user_email || "N/A" %>
                </td>

                <td>
                  <%= d.plan_name || "N/A" %>
                </td>

                <td>
                  R<%= parseFloat(d.amount || 0).toFixed(2) %>
                </td>

                <td>
                  R<%= parseFloat(d.daily_gain || 0).toFixed(2) %>
                </td>

                <td>
                  R<%= parseFloat(d.total_earned || 0).toFixed(2) %>
                </td>

                <td>
                  <%= d.txid || "N/A" %>
                </td>

                <td>

                  <% if (d.status === "Active") { %>

                    <span class="status active">
                      ✅ Active
                    </span>

                  <% } else if (d.status === "Pending") { %>

                    <span class="status pending">
                      ⏳ Pending
                    </span>

                  <% } else { %>

                    <span class="status rejected">
                      ❌ <%= d.status %>
                    </span>

                  <% } %>

                </td>

                <td>

                  <% if (d.status === "Pending") { %>

                    <form
                      method="POST"
                      action="/admin/deposit/<%= d.id %>/approve"
                      style="display:inline;"
                    >

                      <button
                        type="submit"
                        class="action-btn approve"
                      >
                        Approve
                      </button>

                    </form>


                    <form
                      method="POST"
                      action="/admin/deposit/<%= d.id %>/reject"
                      style="display:inline;"
                    >

                      <button
                        type="submit"
                        class="action-btn reject"
                      >
                        Reject
                      </button>

                    </form>

                  <% } else { %>

                    <span style="color:gray;">
                      <%= d.status %>
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>


  <!-- WITHDRAWALS -->

  <div class="dashboard-subcard withdrawals">

    <h3>💸 All Withdrawals</h3>

    <% const safeWithdrawals = withdrawals || []; %>

    <% if (safeWithdrawals.length === 0) { %>

      <p>No withdrawals found.</p>

    <% } else { %>

      <div class="table-wrapper">

        <table class="dashboard-table">

          <thead>

            <tr>
              <th>ID</th>
              <th>User</th>
              <th>Email</th>
              <th>Amount (ZAR)</th>
              <th>Wallet</th>
              <th>Status</th>
              <th>Action</th>
            </tr>

          </thead>

          <tbody>

            <% safeWithdrawals.forEach(w => { %>

              <tr>

                <td>
                  <%= w.id %>
                </td>

                <td>
                  <%= w.user_name || "N/A" %>
                </td>

                <td>
                  <%= w.user_email || "N/A" %>
                </td>

                <td>
                  R<%= parseFloat(w.amount || 0).toFixed(2) %>
                </td>

                <td>
                  <%= w.wallet || "N/A" %>
                </td>

                <td>

                  <% if (w.status === "Approved") { %>

                    <span class="status active">
                      ✅ Approved
                    </span>

                  <% } else if (w.status === "Pending") { %>

                    <span class="status pending">
                      ⏳ Pending
                    </span>

                  <% } else { %>

                    <span class="status rejected">
                      ❌ Rejected
                    </span>

                  <% } %>

                </td>

                <td>

                  <% if (w.status === "Pending") { %>

                    <form
                      method="POST"
                      action="/admin/withdraw/<%= w.id %>/approve"
                      style="display:inline;"
                    >

                      <button
                        type="submit"
                        class="action-btn approve"
                      >
                        Approve
                      </button>

                    </form>


                    <form
                      method="POST"
                      action="/admin/withdraw/<%= w.id %>/reject"
                      style="display:inline;"
                    >

                      <button
                        type="submit"
                        class="action-btn reject"
                      >
                        Reject
                      </button>

                    </form>

                  <% } else { %>

                    <span style="color:gray;">
                      <%= w.status %>
                    </span>

                  <% } %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>

    <% } %>

  </div>

</div>


<style>

/* =========================
   HEADER
========================= */

header {
  width: 100%;
  padding: 18px 35px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}

.logo-container {
  display: flex;
  align-items: center;
}

.logo-container h1 {
  font-size: 2rem;
  color: #1a73e8;
  font-weight: 700;
}

nav a {
  margin-left: 20px;
  color: #1a73e8;
  text-decoration: none;
  font-weight: 600;
}

nav a:hover {
  color: #1258b0;
}


/* =========================
   ALERTS
========================= */

.alert {
  padding: 12px 18px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-weight: 600;
  text-align: center;
  width: 100%;
}

.alert.success {
  background-color: #d4edda;
  color: #155724;
}

.alert.error {
  background-color: #f8d7da;
  color: #721c24;
}


/* =========================
   DASHBOARD
========================= */

.dashboard-card {
  width: 95%;
  max-width: 1500px;
  margin: 30px auto;
  padding: 30px;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  font-family: Arial, sans-serif;
}

.dashboard-card h2 {
  color: #2c3e50;
  text-align: center;
  font-size: 2.6rem;
  margin-bottom: 35px;
}


/* =========================
   KPI CARDS
========================= */

.kpi-cards {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30px;
  gap: 15px;
}

.kpi-card {
  flex: 1 1 22%;
  background: linear-gradient(
    135deg,
    #1a73e8,
    #4facfe
  );
  color: #fff;
  padding: 20px;
  border-radius: 12px;
  text-align: center;
}

.kpi-card h4 {
  font-size: 1rem;
  margin-bottom: 10px;
}

.kpi-card p {
  font-size: 1.8rem;
  font-weight: bold;
}


/* =========================
   SUBCARDS
========================= */

.dashboard-subcard {
  background: #f9f9f9;
  border-radius: 14px;
  padding: 20px;
  margin-bottom: 30px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.06);
}

.dashboard-subcard h3 {
  color: #fff;
  font-size: 1.4rem;
  margin-bottom: 15px;
  padding: 10px 15px;
  border-radius: 8px;
  background: linear-gradient(
    120deg,
    #1a73e8,
    #4facfe
  );
}


/* =========================
   TABLES
========================= */

.table-wrapper {
  overflow-x: auto;
}

.dashboard-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 10px;
}

.dashboard-table th,
.dashboard-table td {
  padding: 12px;
  text-align: center;
  border: 1px solid #ddd;
}

.dashboard-table th {
  background-color: #1a73e8;
  color: #fff;
  text-transform: uppercase;
}

.dashboard-table tr:nth-child(even) {
  background-color: #f9f9f9;
}

.dashboard-table tr:hover {
  background-color: #eef4ff;
}


/* =========================
   STATUS
========================= */

.status {
  font-weight: 600;
}

.status.active {
  color: #27ae60;
}

.status.pending {
  color: #f39c12;
}

.status.rejected {
  color: #e74c3c;
}


/* =========================
   BUTTONS
========================= */

.action-btn {
  border: none;
  padding: 6px 12px;
  margin: 2px;
  border-radius: 8px;
  color: #fff;
  font-weight: 600;
  cursor: pointer;
}

.action-btn.approve {
  background: #27ae60;
}

.action-btn.reject {
  background: #e74c3c;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 1200px) {

  .kpi-cards {
    flex-direction: column;
  }

}

</style>