<header>

  <div class="logo-container">

    <img
      src="/images/background.jpg"
      alt="Logo"
    >

    <h1>
      Stonebridge Capital
    </h1>

  </div>

  <nav>
    <a href="/dashboard">
      Dashboard
    </a>

    <a href="/logout">
      Logout
    </a>
  </nav>

</header>


<div class="auth-page">

  <div class="card">

    <h2>
      Withdraw Funds
    </h2>


    <% if (typeof error !== "undefined" && error) { %>

      <div class="error-message">
        <%= error %>
      </div>

    <% } %>


    <div class="withdraw-info">

      <strong>
        Minimum withdrawal: R100.00
      </strong>

      <p>
        Withdrawals are subject to approval.
      </p>

    </div>


    <form
      action="/withdraw"
      method="POST"
    >


      <label for="amount">
        Amount (ZAR)
      </label>

      <input
        type="number"
        name="amount"
        id="amount"
        required
        step="0.01"
        min="100"
        placeholder="Enter amount in rand"
      >


      <label for="wallet">
        Receiving Wallet Address
      </label>

      <input
        type="text"
        name="wallet"
        id="wallet"
        required
        placeholder="Enter wallet to receive funds"
      >


      <button
        type="submit"
      >
        Submit Withdrawal
      </button>


    </form>

  </div>

</div>


<p class="auth-links">

  <a href="/dashboard">
    Back to Dashboard
  </a>

</p>


<style>

