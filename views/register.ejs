
<header>
  <div class="logo-container">
    <img src="/images/background.jpg" alt="Logo">
    <h1>Stonebridge Capital</h1>
  </div>
  <nav>
    <!-- your nav links -->
  </nav>
</header>



<div class="auth-page">
  <div class="card">
    <h2>Register</h2>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (message) { %>
      <p class="message"><%= message %></p>
    <% } %>

    <form method="POST" action="/register" class="register-form">
      <input type="text" name="name" placeholder="Full Name" required autocomplete="off" />
      <input type="email" name="email" placeholder="Email" required autocomplete="off" />
      <input type="password" name="password" placeholder="Password" required autocomplete="off" />
      <input type="text" name="wallet" placeholder="TRC20 Wallet Address (required)" required autocomplete="off" />

      <input type="hidden" name="referral" value="<%= referral || '' %>">

      <button type="submit" class="btn register-btn">Register</button>
    </form>

    <p class="login-link">Already have an account? <a href="/login">Login here</a></p>
  </div>
</div>

<style>
/* ===== Auth Page ===== */
.auth-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #1a73e8, #4facfe);
  padding: 20px;
  font-family: 'Arial', sans-serif;
}

/* ===== Card ===== */
.card {
  background: #fff;
  padding: 40px 35px;
  border-radius: 20px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  max-width: 450px;
  width: 100%;
  text-align: center;
  transition: transform 0.3s, box-shadow 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 20px 50px rgba(0,0,0,0.25);
}

/* ===== Title ===== */
.card h2 {
  font-size: 2.5rem;
  font-weight: 800;
  color: #1a73e8;
  margin-bottom: 30px;
  position: relative;
}

.card h2::after {
  content: "";
  display: block;
  width: 100px;
  height: 5px;
  background: linear-gradient(90deg, #1a73e8, #4facfe);
  margin: 12px auto 0;
  border-radius: 3px;
}

/* ===== Form Inputs ===== */
.register-form input {
  width: 100%;
  padding: 14px 18px;
  margin-bottom: 20px;
  border-radius: 12px;
  border: 1px solid #ccc;
  font-size: 1rem;
  transition: all 0.25s;
}

.register-form input:focus {
  outline: none;
  border-color: #1a73e8;
  box-shadow: 0 0 10px rgba(26, 115, 232, 0.3);
}

/* ===== Button ===== */
.btn.register-btn {
  width: 100%;
  padding: 15px;
  font-size: 1.1rem;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(to right, #1a73e8, #4facfe);
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.25s;
}

.btn.register-btn:hover {
  transform: translateY(-2px) scale(1.02);
  box-shadow: 0 10px 30px rgba(26, 115, 232, 0.35);
}

/* ===== Error & Message ===== */
.error, .message {
  padding: 10px 15px;
  margin-bottom: 20px;
  border-radius: 10px;
  font-weight: 600;
}

.error {
  background: #fdecea;
  color: #e74c3c;
}

.message {
  background: #eafaf1;
  color: #27ae60;
}

/* ===== Login Link ===== */
.login-link {
  margin-top: 20px;
  font-size: 0.95rem;
}

.login-link a {
  color: #1a73e8;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.25s;
}

.login-link a:hover {
  text-decoration: underline;
  color: #4facfe;
}

/* ===== Responsive ===== */
@media (max-width: 500px) {
  .card {
    padding: 30px 20px;
  }
  .card h2 {
    font-size: 2rem;
  }
}
</style>
