<% layout('layout') %>
<section class="admin">
  <h2>
    <img src="/images/stonebridge-logo.png" height="30" alt="Logo"> 
    Admin Panel
  </h2>

  <h3>All Users</h3>
  <table>
    <tr>
      <th>Username</th>
      <th>Email</th>
      <th>Balance</th>
    </tr>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.username %></td>
        <td><%= u.email %></td>
        <td>$<%= u.balance.toFixed(2) %></td>
      </tr>
    <% }) %>
  </table>

  <h3>Pending Deposits</h3>
  <table>
    <tr>
      <th>User</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
    <% deposits.forEach(dep => { %>
      <tr>
        <td><%= dep.username %></td>
        <td>$<%= dep.amount %></td>
        <td><%= dep.status %></td>
        <td>
          <a href="/admin/approveDeposit/<%= dep.id %>">✅ Approve</a>
          <a href="/admin/rejectDeposit/<%= dep.id %>">❌ Reject</a>
        </td>
      </tr>
    <% }) %>
  </table>

  <h3>Pending Withdrawals</h3>
  <table>
    <tr>
      <th>User</th>
      <th>Amount</th>
      <th>Wallet</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
    <% withdrawals.forEach(w => { %>
      <tr>
        <td><%= w.username %></td>
        <td>$<%= w.amount %></td>
        <td><%= w.wallet %></td>
        <td><%= w.status %></td>
        <td>
          <a href="/admin/approveWithdrawal/<%= w.id %>">✅ Approve</a>
          <a href="/admin/rejectWithdrawal/<%= w.id %>">❌ Reject</a>
        </td>
      </tr>
    <% }) %>
  </table>
</section>
