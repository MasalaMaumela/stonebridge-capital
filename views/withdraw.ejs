

<header>
  <div class="logo-container">
    <img src="/images/background.jpg" alt="Logo">
    <h1>Stonebridge Capital</h1>
  </div>
  <nav>
    <!-- your nav links -->
  </nav>
</header>


<div class="auth-page">
  <div class="card">
    <h2>Withdraw Funds</h2>

    <form action="/withdraw" method="POST">
      <label for="amount">Amount</label>
      <input type="number" name="amount" id="amount" required step="0.01" placeholder="Enter amount">

      <label for="wallet">Receiving Wallet Address</label>
      <input type="text" name="wallet" id="wallet" required placeholder="Enter wallet to receive funds">

      <button type="submit">Submit Withdrawal</button>
 


  </div>
</div>

<p class="auth-links">
  <a href="/dashboard">Back to Dashboard</a>
</p>
