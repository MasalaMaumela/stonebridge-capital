<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Deposit Funds</title>

<style>

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Segoe UI", Arial, sans-serif;
  background: linear-gradient(135deg, #1a73e8, #4facfe);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  color: #333;
}

header {
  width: 100%;
  background: rgba(255,255,255,0.1);
  box-shadow: 0 3px 10px rgba(0,0,0,0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 40px;
  position: sticky;
  top: 0;
  backdrop-filter: blur(8px);
  z-index: 10;
}

header .logo {
  font-size: 1.4rem;
  font-weight: bold;
  color: #fff;
}

nav a {
  margin-left: 25px;
  color: #fff;
  text-decoration: none;
  font-weight: 500;
}

nav a:hover {
  color: #ffd700;
}

main {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 40px 20px;
}

.card {
  background: #fff;
  padding: 30px 25px;
  border-radius: 18px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.15);
  width: 100%;
  max-width: 480px;
}

.card h2 {
  color: #1a73e8;
  font-size: 1.8rem;
  margin-bottom: 15px;
  text-align: center;
}

.card p {
  font-size: 0.95rem;
  line-height: 1.5;
  margin-bottom: 10px;
  color: #444;
}

.error-box {
  background: #fdecea;
  color: #c0392b;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 15px;
  font-weight: 600;
}

form {
  margin-top: 20px;
}

form label {
  display: block;
  font-weight: 600;
  margin-top: 15px;
}

form select,
form input {
  width: 100%;
  padding: 12px;
  margin-top: 6px;
  border-radius: 10px;
  border: 1px solid #ccc;
  font-size: 1rem;
}

form select:focus,
form input:focus {
  border-color: #1a73e8;
  outline: none;
}

button {
  width: 100%;
  background: linear-gradient(to right, #1a73e8, #4facfe);
  color: #fff;
  font-weight: bold;
  border: none;
  border-radius: 12px;
  padding: 14px;
  cursor: pointer;
  margin-top: 25px;
  font-size: 1rem;
}

button:hover {
  transform: translateY(-2px);
}

.profit-box {
  display: none;
  background: #eafaf1;
  color: #27ae60;
  font-weight: 600;
  text-align: center;
  padding: 12px;
  border-radius: 10px;
  margin-top: 15px;
}

footer {
  width: 100%;
  text-align: center;
  padding: 15px 0;
  color: #fff;
  font-size: 0.9rem;
  background: rgba(255,255,255,0.1);
}

@media (max-width: 600px) {

  header {
    flex-direction: column;
    text-align: center;
  }

  nav {
    margin-top: 8px;
  }

  nav a {
    margin: 0 10px;
    font-size: 0.95rem;
  }

  main {
    padding: 25px 10px;
  }

}

</style>
</head>

<body>

<header>

  <div class="logo">
    Stonebridge Capital
  </div>

  <nav>
    <a href="/dashboard">Dashboard</a>
    <a href="/deposit">Deposit</a>
    <a href="/withdraw">Withdraw</a>
    <a href="/logout">Logout</a>
  </nav>

</header>

<main>

  <div class="card">

    <h2>Deposit Funds</h2>

    <% if (typeof error !== "undefined" && error) { %>
      <div class="error-box">
        <%= error %>
      </div>
    <% } %>

    <p>
      Please send your TRC20 deposit to the following address:
    </p>

    <p>
      <strong>
        TH6KhjSWDmP5hgHFrVb59UcAD5qgB6cg6S
      </strong>
    </p>

    <p>
      After sending, copy the
      <strong>Transaction ID (TXID)</strong>
      from your wallet or exchange and paste it below.
    </p>

    <form action="/deposit" method="POST">

      <!-- PLAN -->

      <label for="plan">
        Select Plan
      </label>

      <select
        name="plan_id"
        id="plan"
        required
      >

        <option value="">
          -- Choose a plan --
        </option>

        <% plans.forEach(plan => { %>

          <option
            value="<%= plan.id %>"
            data-daily="<%= plan.daily_return %>"
            data-min="<%= plan.min_amount_zar %>"
          >

            <%= plan.name %>
            — Minimum R<%= Number(plan.min_amount_zar).toFixed(2) %>
            — Daily R<%= Number(plan.daily_return).toFixed(2) %>

          </option>

        <% }) %>

      </select>

      <!-- AMOUNT -->

      <label for="amount">
        Amount (ZAR)
      </label>

      <input
        type="number"
        name="amount"
        id="amount"
        required
        step="0.01"
        min="0"
        placeholder="Enter amount in rand"
      >

      <!-- PROFIT -->

      <div
        id="profit-display"
        class="profit-box"
      ></div>

      <!-- WALLET -->

      <label for="wallet">
        Your Wallet Address
      </label>

      <input
        type="text"
        name="wallet"
        id="wallet"
        required
        placeholder="Enter your wallet address"
      >

      <!-- TXID -->

      <label for="txid">
        Transaction ID (TXID)
      </label>

      <input
        type="text"
        name="txid"
        id="txid"
        required
        placeholder="Paste your transaction ID here"
      >

      <button type="submit">
        Submit Deposit
      </button>

    </form>

  </div>

</main>

<footer>
  © 2026 Stonebridge Capital. All rights reserved.
</footer>

<script>

const planSelect =
  document.getElementById("plan");

const amountInput =
  document.getElementById("amount");

const profitDisplay =
  document.getElementById("profit-display");

function updateProfit() {

  const selected =
    planSelect.options[
      planSelect.selectedIndex
    ];

  if (
    !selected ||
    !selected.value ||
    !amountInput.value
  ) {

    profitDisplay.style.display =
      "none";

    return;
  }

  const min =
    parseFloat(
      selected.dataset.min || 0
    );

  const daily =
    parseFloat(
      selected.dataset.daily || 0
    );

  const amount =
    parseFloat(
      amountInput.value
    );

  if (amount < min) {

    profitDisplay.innerHTML =
      `❌ Minimum deposit is R${min.toFixed(2)}`;

    profitDisplay.style.display =
      "block";

    profitDisplay.style.color =
      "#e74c3c";

    return;
  }

  profitDisplay.style.display =
    "block";

  profitDisplay.style.color =
    "#27ae60";

  profitDisplay.innerHTML = `
    ✅ Estimated Daily Return:<br>
    R${daily.toFixed(2)}
  `;
}

planSelect.addEventListener(
  "change",
  () => {

    const selected =
      planSelect.options[
        planSelect.selectedIndex
      ];

    if (
      selected &&
      selected.dataset.min
    ) {

      amountInput.value =
        selected.dataset.min;
    }

    updateProfit();
  }
);

amountInput.addEventListener(
  "input",
  updateProfit
);

</script>

</body>
</html>